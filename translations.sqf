/*
	[Bro] Simple Cinematic Camera — Localization tables

	Strings are organized as:
		s_*  — CBA setting labels / tooltips (game language, decided at PreInit)
		n_*  — Runtime notifications (respects Bro_SCam_Language override)
		h_*  — HUD labels (respects override)
		p_*  — Keyboard controls hint panel (respects override)
		c_*  — Controller controls hint panel (respects override)

	3-letter tech codes (SPD, FOV, ROLL, ALT, ORI, LAT, FOL, VIS, PAD, NRM, NVG,
	WHOT, BHOT) are kept English in all locales — they're standard cinematic /
	military abbreviations and translating them would hurt readability.

	Use:
		_msg = ["n_fol_on"] call Bro_SCam_L;
		_msg = format [["n_tgt_fmt"] call Bro_SCam_L, name _target];
*/

Bro_SCam_AllTranslations = createHashMap;

